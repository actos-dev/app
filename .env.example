# Backend taban adresi: BFF proxy (`src/app/api/v1/[...path]/route.ts`) ve
# sunucu tarafı oturum doğrulaması (`src/lib/auth/session.ts`) bu adresi kullanır.
# Yerel geliştirme varsayılanı: http://localhost:7055
API_BASE_URL=http://localhost:7055

# Kanonik site adresi: metadataBase, sitemap ve robots bu adresi kullanır.
# Varsayılan: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portföy işlem komisyonu oranı (ALIŞ'ta maliyete eklenir, SATIŞ'ta düşülür).
# Backend `PORTFOLIO_COMMISSION_RATE` ile aynı değerde tutulmalı; varsayılan 0.001.
NEXT_PUBLIC_PORTFOLIO_COMMISSION_RATE=0.001

# Basit feature flag'ler (S-26), virgüllü liste. Sunucu: FLAGS,
# sunucu+istemci: NEXT_PUBLIC_FLAGS (build sırasında inline edilir).
# FLAGS=
# NEXT_PUBLIC_FLAGS=
